    .rootpage__list ol ol>li {
        padding-left: 18px;
    }

    .rootpage__list ol>li::before {
        content: "▸";
        position: absolute;
        left: 0;
        top: 0;
        color: #0066cc;
        font-size: 0.9rem;
        transition: transform 0.2s ease;
    }

    .rootpage__list ol>li:hover::before {
        transform: translateX(3px);
    }

    .rootpage__list ol ol>li::before {
        content: "◦";
        color: #8899aa;
        font-size: 1.1rem;
